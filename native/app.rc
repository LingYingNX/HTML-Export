// 版本信息与图标资源。
//
// 编译进 exe 后：
//   - 资源管理器里显示 app.ico（按尺寸自动挑选）
//   - 右键"属性 → 详细信息"显示下面的版本信息
//   - 代码里可用 LoadImageW(hInst, L"MAINICON", ...) 取到图标
//
// 本文件是 UTF-8 编码，必须声明代码页，否则 rc.exe 按系统代码页（GBK）解析，
// 中文字符串会被拆成非法字节而报 RC2133。

#pragma code_page(65001)

#include <windows.h>

// 主图标：资源名用字符串，代码里直接写 L"MAINICON"
MAINICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0804 = 简体中文，04B0 = Unicode
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "本地工具"
            VALUE "FileDescription",  "序列帧导出工具"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "FrameExporter"
            VALUE "LegalCopyright",   "仅供本地使用"
            VALUE "OriginalFilename", "FrameExporter.exe"
            VALUE "ProductName",      "序列帧导出"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // 中文（简体）语言代码
        VALUE "Translation", 0x804, 1200
    END
END
